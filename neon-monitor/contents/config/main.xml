<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>
    <group name="General">
        <!-- metrics. On by default: what most people expect from a system monitor
             and what works on almost any machine. GPU rows (sensors vary a lot by
             hardware/driver) and most history graphs are opt-in. -->
        <entry name="showCpu" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showCpuGraph" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showRam" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showTemp" type="Bool">
            <default>true</default>
        </entry>
        <!-- 0 = average across cores, 1 = hottest core -->
        <entry name="tempSource" type="Int">
            <default>0</default>
            <min>0</min>
            <max>1</max>
        </entry>
        <entry name="showGpuTemp" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showCpuTempGraph" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showGpuTempGraph" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showGpuUsage" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showGpuUsageGraph" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showGpuPower" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showGpuPowerGraph" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showGpuClock" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showGpuClockGraph" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showGpuVram" type="Bool">
            <default>false</default>
        </entry>
        <!-- full-bar value for GPU power draw (W); the sensor doesn't report a limit.
             0 = auto: scale to the highest draw seen since the widget started -->
        <entry name="gpuPowerScale" type="Int">
            <default>0</default>
            <min>0</min>
            <max>1000</max>
        </entry>
        <!-- which GPU: N in ksystemstats' gpu/gpuN sensors -->
        <entry name="gpuIndex" type="Int">
            <default>0</default>
            <min>0</min>
            <max>15</max>
        </entry>
        <entry name="showDisk" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showNetDown" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showNetUp" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showNetGraph" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showSwap" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showDiskRead" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showDiskWrite" type="Bool">
            <default>false</default>
        </entry>
        <entry name="showDiskIoGraph" type="Bool">
            <default>false</default>
        </entry>
        <!-- network speed units: 0 = bytes per second (MiB/s), 1 = bits per second (Mbps) -->
        <entry name="netUnit" type="Int">
            <default>0</default>
            <min>0</min>
            <max>1</max>
        </entry>
        <!-- comma-separated mount points, one bar each -->
        <entry name="mountPoints" type="String">
            <default>/</default>
        </entry>
        <!-- alert levels: *Warn = warning color, *Crit = critical color + blinking.
             Usage in %, temperatures in °C. -->
        <entry name="cpuWarn" type="Int">
            <default>85</default>
            <min>1</min>
            <max>120</max>
        </entry>
        <entry name="cpuCrit" type="Int">
            <default>95</default>
            <min>1</min>
            <max>120</max>
        </entry>
        <entry name="ramWarn" type="Int">
            <default>85</default>
            <min>1</min>
            <max>120</max>
        </entry>
        <entry name="ramCrit" type="Int">
            <default>95</default>
            <min>1</min>
            <max>120</max>
        </entry>
        <entry name="vramWarn" type="Int">
            <default>85</default>
            <min>1</min>
            <max>120</max>
        </entry>
        <entry name="vramCrit" type="Int">
            <default>95</default>
            <min>1</min>
            <max>120</max>
        </entry>
        <entry name="diskWarn" type="Int">
            <default>90</default>
            <min>1</min>
            <max>120</max>
        </entry>
        <entry name="diskCrit" type="Int">
            <default>95</default>
            <min>1</min>
            <max>120</max>
        </entry>
        <entry name="cpuTempWarn" type="Int">
            <default>80</default>
            <min>1</min>
            <max>120</max>
        </entry>
        <entry name="cpuTempCrit" type="Int">
            <default>90</default>
            <min>1</min>
            <max>120</max>
        </entry>
        <entry name="gpuTempWarn" type="Int">
            <default>80</default>
            <min>1</min>
            <max>120</max>
        </entry>
        <entry name="gpuTempCrit" type="Int">
            <default>90</default>
            <min>1</min>
            <max>120</max>
        </entry>
        <entry name="updateInterval" type="Int">
            <default>1000</default>
            <min>250</min>
            <max>10000</max>
        </entry>

        <!-- appearance -->
        <!-- 0 = Panel (solid HUD box), 1 = Holo (blends into the wallpaper) -->
        <entry name="style" type="Int">
            <default>0</default>
            <min>0</min>
            <max>1</max>
        </entry>
        <entry name="barStyle" type="Int">
            <default>0</default>
            <min>0</min>
            <max>3</max>
        </entry>
        <!-- frame outline (Panel) / corner brackets (Holo) and the accent tabs -->
        <entry name="showBorder" type="Bool">
            <default>true</default>
        </entry>
        <!-- title line and divider at the top -->
        <entry name="showHeader" type="Bool">
            <default>true</default>
        </entry>
        <entry name="primaryColor" type="Color">
            <default>#00f0ff</default>
        </entry>
        <entry name="accentColor" type="Color">
            <default>#ff2a6d</default>
        </entry>
        <!-- used when a value reaches a critical level -->
        <!-- warning color: follows the accent color unless the user picks their own -->
        <entry name="warningSameAsAccent" type="Bool">
            <default>true</default>
        </entry>
        <entry name="warningColor" type="Color">
            <default>#ff2a6d</default>
        </entry>
        <entry name="criticalColor" type="Color">
            <default>#ff1a1a</default>
        </entry>
        <entry name="backgroundOpacity" type="Int">
            <default>75</default>
            <min>0</min>
            <max>100</max>
        </entry>
        <entry name="fontFamily" type="String">
            <default></default>
        </entry>
        <entry name="glow" type="Bool">
            <default>false</default>
        </entry>
        <entry name="scanlines" type="Bool">
            <default>true</default>
        </entry>
        <!-- slow glow band moving down the widget (costs a little CPU: it redraws ~15x a second) -->
        <entry name="scanSweep" type="Bool">
            <default>true</default>
        </entry>
    </group>
</kcfg>
